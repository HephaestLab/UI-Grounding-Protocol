{
  "name": "ui-grounding-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Vendor-neutral protocol for resolving UI selections into authoritative application referents.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "changeset": "changeset",
    "check": "pnpm lint && pnpm format:check && pnpm generate:types:check && pnpm typecheck && pnpm test:coverage && pnpm test:conformance",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "experiment:prepare": "node experiments/chi-pilot/scripts/prepare.mjs",
    "experiment:score": "node experiments/chi-pilot/scripts/score.mjs",
    "experiment:session:prepare": "node experiments/chi-pilot/scripts/prepare-session.mjs",
    "experiment:session:reveal": "node experiments/chi-pilot/scripts/reveal-session.mjs",
    "experiment:session:score": "node experiments/chi-pilot/scripts/score-session.mjs",
    "experiment:validate": "node experiments/chi-pilot/scripts/validate.mjs",
    "experiment:v02:prepare": "node experiments/semantic-authoring-v02/scripts/prepare.mjs",
    "experiment:v02:transfer:prepare": "node experiments/semantic-authoring-v02/scripts/prepare-transfer.mjs",
    "experiment:v02:transfer:reveal": "node experiments/semantic-authoring-v02/scripts/reveal-transfer.mjs",
    "experiment:v02:transfer:score": "node experiments/semantic-authoring-v02/scripts/score-transfer.mjs",
    "experiment:v02:score": "node experiments/semantic-authoring-v02/scripts/score.mjs",
    "experiment:v02:preflight": "node experiments/semantic-authoring-v02/scripts/preflight.mjs",
    "experiment:v02:validate": "node experiments/semantic-authoring-v02/scripts/validate.mjs",
    "experiment:v03:validate": "node experiments/grounding-main-v03/scripts/validate.mjs",
    "experiment:v03:doctor": "node experiments/grounding-main-v03/scripts/doctor.mjs",
    "experiment:v03:vendor:check": "node experiments/grounding-main-v03/scripts/vendor-check.mjs",
    "experiment:v03:vendor:sync": "node experiments/grounding-main-v03/scripts/vendor-sync.mjs",
    "experiment:v03:preflight": "node experiments/grounding-main-v03/scripts/preflight.mjs",
    "experiment:v03:prepare": "node experiments/grounding-main-v03/scripts/prepare.mjs",
    "experiment:v03:record": "node experiments/grounding-main-v03/scripts/record.mjs",
    "experiment:v03:score": "node experiments/grounding-main-v03/scripts/score.mjs",
    "experiment:v03:summarize": "node experiments/grounding-main-v03/scripts/summarize.mjs",
    "experiment:v03:analyze": "node experiments/grounding-main-v03/scripts/analyze.mjs",
    "generate:types": "node scripts/generate-types.mjs",
    "generate:types:check": "node scripts/generate-types.mjs --check",
    "lint": "eslint .",
    "audit:dependencies": "pnpm audit --audit-level high",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts --passWithNoTests",
    "test:browser:coverage": "vitest run --config vitest.browser-coverage.config.ts --coverage",
    "test:conformance": "pnpm --filter @ui-grounding/conformance-runner conformance",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:performance": "node --expose-gc tests/performance/release-budgets.mjs",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:release": "pnpm check && pnpm test:browser && pnpm test:browser:coverage && pnpm build && pnpm test:e2e && pnpm test:performance && pnpm test:security && pnpm pack:smoke && pnpm audit:dependencies",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/node": "26.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "esbuild": "0.28.2",
    "fast-check": "4.9.0",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
