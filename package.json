{
  "name": "ui-grounding-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Vendor-neutral protocol for resolving UI selections into authoritative application referents.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "changeset": "changeset",
    "check": "pnpm lint && pnpm format:check && pnpm generate:types:check && pnpm typecheck && pnpm test:coverage && pnpm test:conformance",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:types": "node scripts/generate-types.mjs",
    "generate:types:check": "node scripts/generate-types.mjs --check",
    "lint": "eslint .",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts --passWithNoTests",
    "test:conformance": "pnpm --filter @ui-grounding/conformance-runner conformance",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "fast-check": "4.9.0",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
