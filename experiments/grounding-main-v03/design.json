  "claimBoundary": "The confirmatory study estimates the effect of the current-step grounding representation under a fixed minimal actor loop; it does not estimate the value of a complete vendor agent stack.",
  "researchQuestions": [
    {
      "id": "RQ1",
      "question": "Does UGP improve correct interpretation of a user-pointed UI referent relative to visual, structural, and published-interface baselines?"
    },
    {
      "id": "RQ2",
      "question": "Does the referent improvement transfer to successful long-horizon web task execution when the actor and action space are held fixed?"
    },
    {
      "id": "RQ3",
      "question": "Does UGP improve policy-compliant utility on safety-sensitive tasks without increasing unsafe action attempts?"
    }
  ],
