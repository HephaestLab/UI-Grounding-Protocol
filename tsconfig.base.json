{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@ui-grounding/core": ["./packages/core/src/index.ts"],
      "@ui-grounding/dom": ["./packages/dom/src/index.ts"],
      "@ui-grounding/overlay": ["./packages/overlay/src/index.ts"],
      "@ui-grounding/protocol": ["./packages/protocol/src/index.ts"],
      "@ui-grounding/react": ["./packages/react/src/index.ts"],
      "@ui-grounding/testing": ["./packages/testing/src/index.ts"]
    }
  }
}
