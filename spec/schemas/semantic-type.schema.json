{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-grounding.org/schema/v0.1/semantic-type.schema.json",
  "title": "SemanticType",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "title", "description", "version"],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "version": { "$ref": "common.schema.json#/$defs/revision" },
    "schema": { "type": "object" },
    "extends": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
      }
    },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  }
}
