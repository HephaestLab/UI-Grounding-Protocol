{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-grounding.org/schema/v0.1/grounding-bundle.schema.json",
  "title": "GroundingBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["groundingId", "selection", "referents", "generatedAt"],
  "properties": {
    "groundingId": { "$ref": "common.schema.json#/$defs/identifier" },
    "selection": { "$ref": "selection.schema.json" },
    "referents": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "resolved-referent.schema.json" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/semanticRelationship" }
    },
    "omitted": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/omittedResult" }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresDisambiguation"],
      "properties": {
        "requiresDisambiguation": { "type": "boolean" },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "resolved-referent.schema.json" }
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "requiresDisambiguation": { "const": true } },
            "required": ["requiresDisambiguation"]
          },
          "then": {
            "required": ["candidates", "reason"],
            "properties": { "candidates": {}, "reason": {} }
          }
        }
      ]
    },
    "problem": { "$ref": "grounding-problem.schema.json" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  }
}
