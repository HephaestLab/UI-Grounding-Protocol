{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-grounding.org/schema/v0.2-draft/semantic-value.schema.json",
  "title": "SemanticValue",
  "oneOf": [
    { "type": "string", "maxLength": 4096 },
    { "type": "number" },
    { "type": "boolean" },
    { "type": "null" },
    { "$ref": "common.schema.json#/$defs/entity" },
    { "$ref": "common.schema.json#/$defs/quantity" },
    { "$ref": "common.schema.json#/$defs/instant" },
    { "$ref": "common.schema.json#/$defs/interval" },
    { "$ref": "common.schema.json#/$defs/collection" },
    { "$ref": "common.schema.json#/$defs/nestedFrame" }
  ]
}
