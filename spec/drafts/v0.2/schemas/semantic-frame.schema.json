{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-grounding.org/schema/v0.2-draft/semantic-frame.schema.json",
  "title": "SemanticFrame",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "subject", "roles"],
  "properties": {
    "type": { "$ref": "common.schema.json#/$defs/semanticType" },
    "subject": { "$ref": "common.schema.json#/$defs/entity" },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "common.schema.json#/$defs/identifier" },
      "additionalProperties": { "$ref": "semantic-value.schema.json" }
    }
  }
}
